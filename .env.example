# ------------------------------------------------------------------
# Cellova Labs — Environment Configuration
# Copy this file to .env.local and fill in values for your environment.
# NEVER commit real credentials. NEVER put private/admin keys in
# NEXT_PUBLIC_* variables.
# ------------------------------------------------------------------

# Public base URL of the deployed site (used for canonical URLs,
# Open Graph tags, sitemap, and JSON-LD).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------
# Commerce provider selection: mock | medusa | shopify
# "mock" runs the full storefront against demo data in lib/mock-data/
# with zero external services.
# ------------------------------------------------------------------
COMMERCE_PROVIDER=mock

# --- Medusa v2 (used when COMMERCE_PROVIDER=medusa) ---
# Publishable key only — never admin tokens.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# --- Shopify Storefront API (used when COMMERCE_PROVIDER=shopify) ---
# Public Storefront token only — never Admin API tokens.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
NEXT_PUBLIC_SHOPIFY_API_VERSION=2025-01

# ------------------------------------------------------------------
# Payment provider selection: mock (default) | tagada (future)
# Tagada Pay credentials are SERVER-ONLY — no NEXT_PUBLIC_ prefix.
# ------------------------------------------------------------------
PAYMENT_PROVIDER=mock
TAGADA_API_KEY=
TAGADA_WEBHOOK_SECRET=
